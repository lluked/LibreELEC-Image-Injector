--- fs-resize
+++ fs-resize
@@ -10,6 +10,88 @@
   StartProgress "$@"
 }
 
+backup_dir="/run/fs-resize-config-backup"
+wifi_provisioned_files="@WIFI_PROVISIONED_FILES@"
+
+backup_wifi() {
+  rm -rf "${backup_dir}/wifi"
+  for wifi_file in ${wifi_provisioned_files}; do
+    if [ -f "/storage/.cache/connman/${wifi_file}" ]; then
+      mkdir -p "${backup_dir}/wifi"
+      cp "/storage/.cache/connman/${wifi_file}" "${backup_dir}/wifi/"
+    fi
+  done
+}
+
+restore_wifi() {
+  if [ -d "${backup_dir}/wifi" ]; then
+    mkdir -p /storage/.cache/connman
+    cp "${backup_dir}/wifi/"* /storage/.cache/connman/ 2>/dev/null
+    rm -rf "${backup_dir}/wifi"
+  fi
+}
+
+backup_ssh_authorized_keys() {
+  rm -rf "${backup_dir}/ssh"
+  if [ -f /storage/.ssh/authorized_keys ]; then
+    mkdir -p "${backup_dir}/ssh"
+    cp /storage/.ssh/authorized_keys "${backup_dir}/ssh/"
+  fi
+}
+
+restore_ssh_authorized_keys() {
+  if [ -f "${backup_dir}/ssh/authorized_keys" ]; then
+    mkdir -p /storage/.ssh
+    cp "${backup_dir}/ssh/authorized_keys" /storage/.ssh/
+    chmod 700 /storage/.ssh
+    chmod 600 /storage/.ssh/authorized_keys
+    rm -rf "${backup_dir}/ssh"
+  fi
+}
+
+backup_sshd_conf() {
+  rm -rf "${backup_dir}/sshd"
+  if [ -f /storage/.cache/services/sshd.conf ]; then
+    mkdir -p "${backup_dir}/sshd"
+    cp /storage/.cache/services/sshd.conf "${backup_dir}/sshd/"
+  fi
+}
+
+restore_sshd_conf() {
+  if [ -f "${backup_dir}/sshd/sshd.conf" ]; then
+    mkdir -p /storage/.cache/services
+    cp "${backup_dir}/sshd/sshd.conf" /storage/.cache/services/
+    rm -rf "${backup_dir}/sshd"
+  fi
+}
+
+# /storage/.cache is "clean" for resize purposes if the only things in
+# it are: systemd-machine-id (confirmed via debug logging at this exact
+# guard check on real hardware to be genuinely present within
+# fs-resize's own isolated boot - the only thing confirmed to appear
+# this early); ConnMan's own connman/ directory (whatever ConnMan itself
+# has put there is its business, not evidence Kodi has run); and, inside
+# services/, only this tool's own sshd.conf. This guard only runs once
+# per device (the .please_resize_me marker is deleted on every
+# evaluation), so anything else in services/ (avahi.conf, samba.conf,
+# say) is evidence a later boot already happened, and still blocks
+# resize.
+cache_has_unexpected_content() {
+  if [ -d /storage/.cache/services ]; then
+    if [ -n "$(find /storage/.cache/services -mindepth 1 -maxdepth 1 \
+        ! -name sshd.conf \
+        -print -quit 2>/dev/null)" ]; then
+      return 0
+    fi
+  fi
+
+  [ -n "$(find /storage/.cache -mindepth 1 -maxdepth 1 \
+      ! -name systemd-machine-id \
+      ! -name connman \
+      ! -name services \
+      -print -quit 2>/dev/null)" ]
+}
+
 if [ -e /storage/.please_resize_me ] ; then
   . /usr/lib/libreelec/functions
 
@@ -21,7 +103,12 @@
 
   # this sh** was never intended to be used
   # on an already installed and running system
-  if [ -d /storage/.kodi -o -d /storage/.config -o -d /storage/.cache ] ; then
+  # NB: /storage/.cache/connman and /storage/.cache/services are
+  # deliberately not treated as evidence of that by themselves - see
+  # cache_has_unexpected_content() above. Whatever's provisioned here
+  # that would otherwise be lost to the mke2fs reformat below is backed
+  # up and restored around it instead.
+  if [ -d /storage/.kodi -o -d /storage/.config ] || cache_has_unexpected_content ; then
     rm -f /storage/.please_resize_me
     sync
     echo "Resizing is not permitted - the system has already been initialised." | tee -a $LOG
@@ -54,6 +141,9 @@
 
   # just in case
   if [ ! -z "$DISK" -a ! -z "$PART" -a ! -z "$UUID" ] ; then
+    backup_wifi
+    backup_ssh_authorized_keys
+    backup_sshd_conf
     umount $PART
 
     echo "PARTITION RESIZING IN PROGRESS"
@@ -64,6 +154,11 @@
     StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK resizepart 2 100% >>$LOG 2>&1"
     StartProgressLog spinner "Creating file system... " "mke2fs -F -q -t ext4 -m 0 -L \"$LABEL\" -U \"$UUID\" $PART >>$LOG 2>&1"
     StartProgressLog spinner "Checking file system... " "e2fsck -f -p $PART >>$LOG 2>&1"
+    mount $PART /storage
+    restore_wifi
+    restore_ssh_authorized_keys
+    restore_sshd_conf
+    umount $PART
     StartProgress countdown "Rebooting in 15s...     " 15 "NOW"
   else
     echo "Partition was not detected - resizing aborted."
