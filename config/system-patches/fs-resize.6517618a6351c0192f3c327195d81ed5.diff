--- fs-resize
+++ fs-resize
@@ -10,6 +10,54 @@
   StartProgress "$@"
 }
 
+backup_dir="/run/fs-resize-config-backup"
+wifi_provisioned_files="@WIFI_PROVISIONED_FILES@"
+
+backup_wifi() {
+  rm -rf "${backup_dir}/wifi"
+  for wifi_file in ${wifi_provisioned_files}; do
+    if [ -f "/storage/.cache/connman/${wifi_file}" ]; then
+      mkdir -p "${backup_dir}/wifi"
+      cp "/storage/.cache/connman/${wifi_file}" "${backup_dir}/wifi/"
+    fi
+  done
+}
+
+restore_wifi() {
+  if [ -d "${backup_dir}/wifi" ]; then
+    mkdir -p /storage/.cache/connman
+    cp "${backup_dir}/wifi/"* /storage/.cache/connman/ 2>/dev/null
+    rm -rf "${backup_dir}/wifi"
+  fi
+}
+
+backup_ssh() {
+  rm -rf "${backup_dir}/ssh"
+  if [ -f /storage/.ssh/authorized_keys ]; then
+    mkdir -p "${backup_dir}/ssh"
+    cp /storage/.ssh/authorized_keys "${backup_dir}/ssh/"
+  fi
+}
+
+restore_ssh() {
+  if [ -f "${backup_dir}/ssh/authorized_keys" ]; then
+    mkdir -p /storage/.ssh
+    cp "${backup_dir}/ssh/authorized_keys" /storage/.ssh/
+    chmod 700 /storage/.ssh
+    chmod 600 /storage/.ssh/authorized_keys
+    rm -rf "${backup_dir}/ssh"
+  fi
+}
+
+# /storage/.cache is "clean" for resize purposes if the only thing in it is
+# ConnMan's own connman/ directory (whatever ConnMan itself has put inside
+# that - provisioning files, its own settings, managed_psk state - all of
+# that is ConnMan's business, not evidence Kodi has run). Anything else
+# directly under .cache is a real signal of prior initialisation.
+cache_has_other_than_connman() {
+  [ -n "$(find /storage/.cache -mindepth 1 -maxdepth 1 ! -name connman -print -quit 2>/dev/null)" ]
+}
+
 if [ -e /storage/.please_resize_me ] ; then
   . /usr/lib/libreelec/functions
 
@@ -21,7 +69,13 @@
 
   # this sh** was never intended to be used
   # on an already installed and running system
-  if [ -d /storage/.kodi -o -d /storage/.config -o -d /storage/.cache ] ; then
+  # NB: /storage/.cache/connman is deliberately not treated as evidence of
+  # that by itself - headless WiFi provisioning (before first boot) and
+  # ConnMan itself (within seconds of first boot, the moment it actually
+  # connects) both legitimately write there. Anything provisioned here
+  # that would otherwise be lost to the mke2fs reformat below is backed up
+  # and restored around it instead.
+  if [ -d /storage/.kodi -o -d /storage/.config ] || cache_has_other_than_connman ; then
     rm -f /storage/.please_resize_me
     sync
     echo "Resizing is not permitted - the system has already been initialised." | tee -a $LOG
@@ -54,6 +108,8 @@
 
   # just in case
   if [ ! -z "$DISK" -a ! -z "$PART" -a ! -z "$UUID" ] ; then
+    backup_wifi
+    backup_ssh
     umount $PART
 
     echo "PARTITION RESIZING IN PROGRESS"
@@ -64,6 +120,10 @@
     StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK resizepart 2 100% >>$LOG 2>&1"
     StartProgressLog spinner "Creating file system... " "mke2fs -F -q -t ext4 -m 0 -L \"$LABEL\" -U \"$UUID\" $PART >>$LOG 2>&1"
     StartProgressLog spinner "Checking file system... " "e2fsck -f -p $PART >>$LOG 2>&1"
+    mount $PART /storage
+    restore_wifi
+    restore_ssh
+    umount $PART
     StartProgress countdown "Rebooting in 15s...     " 15 "NOW"
   else
     echo "Partition was not detected - resizing aborted."
